# Yacht OS environment variables
#
# Copy to `.env.local` for local development and fill in real values.
# `.env*` is gitignored; this example file is the only one committed.
#
# Names below are verified against process.env usage in app/ and lib/.

# ---------------------------------------------------------------- Supabase
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable ("anon") key. Safe in the browser: it is subject to Row Level
# Security. Note the name is PUBLISHABLE_KEY, not ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret service-role key. NEVER expose to the browser, never prefix with
# NEXT_PUBLIC_. It bypasses Row Level Security entirely, so anything holding
# it can read and write every company's data.
# Only lib/supabase/admin.ts may read this value; admin.ts validates at
# runtime that a publishable key has not been pasted here by mistake.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- OpenAI
# Billed per call. Every route that spends it is authenticated and rate
# limited (see lib/security/rate-limit.ts).
OPENAI_API_KEY=

# Optional. Model used for inquiry extraction.
# OPENAI_MODEL=

# Optional. Model used by the adaptive data-source extractor, which handles
# supplier formats the deterministic parsers do not recognise.
# OPENAI_SOURCE_MODEL=

# ---------------------------------------------------------------- Google
# OAuth client for the Gmail send integration. Create at
# console.cloud.google.com under APIs & Services > Credentials.
GOOGLE_EMAIL_CLIENT_ID=
GOOGLE_EMAIL_CLIENT_SECRET=

# Must exactly match an authorised redirect URI registered with Google, e.g.
# https://app.yachtos.de/api/email/google/callback
GOOGLE_EMAIL_REDIRECT_URI=

# Signs the OAuth `state` parameter to prevent CSRF on the connect flow.
# Generate with:  openssl rand -base64 32
EMAIL_OAUTH_STATE_SECRET=

# ---------------------------------------------------------------- Scraping
# Browserless token for rendering JavaScript-driven supplier sites that the
# static fetch cannot read. Optional: website sources fall back to plain
# fetch when this is unset, which works for server-rendered pages only.
BROWSERLESS_TOKEN=

# ---------------------------------------------------------------- App
# Absolute public origin, no trailing slash. Used to build guest portal,
# proposal review and itinerary share links that get emailed to clients.
# Wrong value here sends clients a dead link, so set it per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000